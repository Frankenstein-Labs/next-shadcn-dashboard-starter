# Aetheris Cloud — environment template
# Copy to .env.local for local development. Never commit real secrets.

# Clerk authentication (required for protected routes)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard/overview
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard/overview
WEBHOOK_SECRET=

# Application and build
NEXT_PUBLIC_APP_URL=http://localhost:3000
BUILD_STANDALONE=true

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ORG=
NEXT_PUBLIC_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DISABLED=false

# Frankenstein-Labs Marketplace (optional; server-only secret)
FRANKENSTEIN_API_URL=https://frankenstein-api.onrender.com
FRANKENSTEIN_API_SECRET=
FRANKENSTEIN_API_TIMEOUT_MS=75000

# Aetheris API Hub — server-only provider credentials
FORGE_API_KEY=
UNOROUTER_API_KEY=
AGENT_NEXUS_API_KEY=

# Aetheris API Hub — public providers do not require credentials
# NEURONTO_API_KEY=       # optional only if the provider later requires one
# WANDBOX_API_KEY=        # public API; kept for future authenticated plans
# NPM_REGISTRY_TOKEN=     # only for private npm operations
# CDNJS_API_KEY=          # public API; leave empty
# APIS_GURU_API_KEY=      # public API; leave empty
# PRISMIX_API_KEY=        # public status API; leave empty

# SearXNG Render instance (server-only URL)
SEARXNG_API_URL=https://aetheris-searxng-uj0m.onrender.com

# Reserved names for integrations not implemented in the current codebase.
# Do not add credentials until their official contracts are verified.
# MESSENGERX_API_KEY=
# SPAM_HUNTER_API_KEY=
# SFW_API_KEY=
# AGENTDEALS_API_KEY=
# PYTHONIUM_API_KEY=
# PHPHUB_API_KEY=
# SOFTWIUM_API_KEY=
# SCREENSHOTBASE_API_KEY=
# TOOLBOX_500_API_KEY=
# TIMELOGIC_API_KEY=
# QR_KEPT_API_KEY=
# ABACUS_API_KEY=

# There is currently no Supabase integration in this repository, so no
# SUPABASE_* variable is required. Add one only with a real Supabase adapter.
